# wcp: config/.clang-tidy base=8fde61052c61
---
# NOTE: `Checks:` below is a YAML folded scalar. A '#' inside it is NOT a
# comment — it gets folded into the check string and silently corrupts the
# list. Keep all commentary out here, above the key.
#
# Every check disabled after the first two fired on untouched code, which is
# how a gate teaches people to ignore it. Each is off for one of two reasons:
# it fights a convention this codebase holds on purpose, or it is a defect in
# clang-tidy itself. The reason is recorded per check below.
#
#   readability-identifier-length      Short names are the reference papers'
#                                      notation and ordinary loop indices
#                                      (i, j, q, b, L). Alone it was 321 of
#                                      513 warnings on one TU.
#   modernize-avoid-c-arrays           Fixed-size C arrays are deliberate in
#                                      the SIMD and bucket-grid paths.
#   readability-implicit-bool-conversion
#   readability-math-missing-parentheses
#                                      Numeric solver code converts between
#                                      int-like and bool-like freely, and
#                                      parenthesising every mixed expression
#                                      hurts the match against the papers'
#                                      formulae more than it helps.
#   readability-uppercase-literal-suffix
#                                      Spelling preference, no bug class.
#   bugprone-easily-swappable-parameters
#                                      Low signal on numeric interfaces, where
#                                      adjacent same-typed parameters are the
#                                      normal shape.
#   modernize-use-std-print            Segfaults clang-tidy 21.1.8 on
#                                      cli/main.cpp's fprintf calls. A
#                                      crash analyses nothing, so this
#                                      stays off until upstream fixes it.
#   readability-function-cognitive-complexity
#                                      The labeling hot paths score 60-265
#                                      against a threshold of 25, and they
#                                      are complex because dominance,
#                                      concatenation and bucket fixing are.
#                                      This project's standing rule is to
#                                      explain such a function rather than
#                                      split it mechanically, so the check
#                                      can only ever be ignored here. It
#                                      also fires on every doctest TEST_CASE
#                                      body, which is a table of assertions,
#                                      not a function to refactor.
#   readability-convert-member-functions-to-static
#                                      All 26 hits were Resource concept
#                                      hooks (symmetric, init_state,
#                                      domination_cost, ...). The concept
#                                      fixes the signature; whether a given
#                                      resource needs `this` is an
#                                      implementation detail that must not
#                                      leak into the interface, or a
#                                      stateless resource and a stateful one
#                                      would spell the same hook differently.
#   modernize-use-integer-sign-comparison
#                                      False positive in clang-tidy 21.1.8:
#                                      it flags `i < static_cast<int>(v.size())`
#                                      — both operands already int — and
#                                      proposes std::cmp_less over the cast
#                                      the code uses to resolve the very
#                                      mismatch being reported. Re-test
#                                      before re-enabling.
Checks: >
  -*,
  bugprone-*,
  modernize-*,
  performance-*,
  readability-*,
  -modernize-use-trailing-return-type,
  -readability-magic-numbers,
  -readability-identifier-length,
  -modernize-avoid-c-arrays,
  -readability-implicit-bool-conversion,
  -readability-math-missing-parentheses,
  -readability-uppercase-literal-suffix,
  -bugprone-easily-swappable-parameters,
  -modernize-use-std-print,
  -readability-function-cognitive-complexity,
  -readability-convert-member-functions-to-static,
  -modernize-use-integer-sign-comparison

CheckOptions:
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  - key: readability-identifier-naming.StructCase
    value: CamelCase
  - key: readability-identifier-naming.FunctionCase
    value: lower_case
  - key: readability-identifier-naming.NamespaceCase
    value: lower_case
  - key: readability-identifier-naming.VariableCase
    value: lower_case
  # Short capitals (optionally indexed) and capital_new pairs are the reference
  # papers' notation: L/L0/L1 for labels, P/D for pickup and delivery loads,
  # N/W/A for set sizes and SIMD widths. Renaming these to snake_case would
  # obscure the mapping back to the papers, which is the thing that makes this
  # code checkable against them.
  - key: readability-identifier-naming.VariableIgnoredRegexp
    value: '^([A-Z]{1,2}[0-9]*|[A-Z]_new)$'
  - key: readability-identifier-naming.PrivateMemberSuffix
    value: _
  # Constants are deliberately not case-checked. The codebase carries two
  # conventions on purpose — UPPER_CASE for the numeric limits in types.h
  # (INF, EPS, NEG_INF; public API, ~225 call sites) and k-prefixed CamelCase
  # for internal tuning knobs. Enforcing either one would mean renaming the
  # other, so constants are left to review rather than to the linter.
  #
  # This has to be spelled out as aNy_CasE rather than left unset: an unset
  # constant scope falls through to VariableCase, which then flags every one
  # of them. ConstantMemberCase stays out of the list entirely — it outranks
  # PrivateMemberSuffix and would fight the trailing-underscore rule.
  - key: readability-identifier-naming.ConstantCase
    value: aNy_CasE
  - key: readability-identifier-naming.ConstantParameterCase
    value: aNy_CasE
  - key: readability-identifier-naming.LocalConstantCase
    value: aNy_CasE
  - key: readability-identifier-naming.StaticConstantCase
    value: aNy_CasE
  - key: readability-identifier-naming.GlobalConstantCase
    value: aNy_CasE
  - key: readability-identifier-naming.ClassConstantCase
    value: aNy_CasE
  - key: readability-identifier-naming.ConstexprVariableCase
    value: aNy_CasE
  # aNy_CasE accepts any case but still rejects a trailing underscore, and
  # ConstexprVariable has no suffix option that composes with
  # PrivateMemberSuffix. Private static constexpr members follow the same
  # trailing-underscore convention as every other private member, so spell
  # that shape out here.
  - key: readability-identifier-naming.ConstexprVariableIgnoredRegexp
    value: '^[a-z][a-z0-9_]*_$'

WarningsAsErrors: ''
# Project headers only. '.*' also matches FetchContent's vendored sources
# under build/_deps, where `clang-tidy --fix` would rewrite third-party code.
HeaderFilterRegex: '(include/bgspprc|cli)/'
FormatStyle: file
