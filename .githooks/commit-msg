#!/bin/sh
# wcp: commit-msg base=f49666df061f
# Conventional Commits, enforced.
#
# A real file in this repository, not a shim. `wcp init` copied it here from the
# copy wcp carries; the `# wcp:` line above records which copy, so `wcp doctor`
# can tell a file you edited from one wcp has since moved on from. Editing it is
# allowed — doctor only offers to refresh a hook you have not touched.
#
# Self-contained on purpose. It runs no wcp and no project tooling, so it needs
# nothing but POSIX sh and git, and it still gates a clone that has never heard
# of wcp. Nothing here can fail open, because there is nothing here to be
# missing.

set -u

TYPES='feat|fix|refactor|test|docs|style|perf|chore|build|ci'
MAX_SUBJECT=72

msg_file=${1:-}
if [ -z "$msg_file" ]; then
	echo "commit-msg: no message file given" >&2
	exit 1
fi

# A message file that cannot be read is git's problem to report. A second error
# from here would only be a confusing one alongside it.
[ -r "$msg_file" ] || exit 0

# Emptying the buffer is how a commit is cancelled from the editor, and
# `--allow-empty-message` is how it is forced past that. Refuse both — but
# without the Conventional Commits help below, which answers a message somebody
# wrote, and there is none here to fix.
#
# A line counts as content when it holds something other than whitespace and
# does not begin with `#`. Note where the two halves apply: `   # note` is
# indented, so it does not begin with `#`, and it is content.
if ! grep -v '^#' "$msg_file" | grep -q '[^[:space:]]'; then
	echo "ERROR: empty commit message." >&2
	exit 1
fi

subject=$(sed -n '1p' "$msg_file")

# git writes these itself. Holding its own wording to the format would refuse
# the merge and the revert git just asked for.
case $subject in
Merge\ * | Revert\ *) exit 0 ;;
esac

# This project's own: `git commit --fixup` subjects pass, so `git rebase
# --autosquash` works. Folded away before a push, they never reach main.
# Also this project's: `type!:` marks a breaking change, as Conventional
# Commits allows (the `!?` in the pattern below).
case $subject in
fixup!\ * | squash!\ * | amend!\ *) exit 0 ;;
esac

if ! printf '%s\n' "$subject" | grep -qE "^($TYPES)(\(.+\))?!?: .+"; then
	cat >&2 <<'EOF'
ERROR: commit message does not follow Conventional Commits.

  Expected: type: description
  Optional: type(scope): description

  Types: feat, fix, refactor, test, docs, style, perf, chore, build, ci

  Examples:
    feat: add branch-and-bound solver
    fix(parser): handle empty input
    refactor: extract constraint builder
EOF
	printf '  Your message: %s\n' "$subject" >&2
	exit 1
fi

# Characters where the shell counts them and bytes where it does not — dash
# counts bytes, bash counts characters. The two answers differ only for a
# non-ASCII subject already within a few bytes of the limit, which is not worth
# a second process per commit to reconcile.
if [ ${#subject} -gt $MAX_SUBJECT ]; then
	printf 'ERROR: subject is %s chars (max %s).\n' "${#subject}" "$MAX_SUBJECT" >&2
	printf '  %s\n' "$subject" >&2
	exit 1
fi

exit 0
